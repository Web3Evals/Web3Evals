---
layout: layouts/base.njk
isBlog: true
isPost: true
---
{#- Research post layout: wide 1040px article column, hero with kicker/deck/
    meta, and a fixed left "Contents" rail defined in the post's `toc`
    frontmatter. Mirrors the standalone research-page design. -#}
{#- collections.posts is newest-first; "older" is the next item, "newer" the previous -#}
{%- set older = null -%}
{%- set newer = null -%}
{%- for p in collections.posts -%}
  {%- if p.url == page.url -%}
    {%- if not loop.first -%}{%- set newer = collections.posts[loop.index0 - 1] -%}{%- endif -%}
    {%- if not loop.last -%}{%- set older = collections.posts[loop.index0 + 1] -%}{%- endif -%}
  {%- endif -%}
{%- endfor -%}
    <main class="site-main post-main research" id="main">
      <article class="post">
        <header class="post-hero">
          <div class="post-hero-inner">
            {%- if kicker %}
            <div class="post-kicker">{{ kicker }}</div>
            {%- endif %}
            <h1 class="post-title">{{ title }}</h1>
            <p class="post-deck">{{ description }}</p>
            <div class="post-meta">
              <span>{{ site.name | lower }}</span>
              <span><time datetime="{{ page.date | dateIso }}">{{ page.date | dateMonthYear }}</time></span>
              {%- if readTime %}
              <span>{{ readTime }}</span>
              {%- endif %}
            </div>
          </div>
        </header>

        <div class="post-layout">
          {%- if toc %}
          <nav class="post-toc" aria-label="Table of contents">
            <div class="post-toc-title">Contents</div>
            <ol>
              {%- for item in toc %}
              <li{% if item.sub %} class="sub"{% endif %}><a href="#{{ item.id }}">{{ item.label }}</a></li>
              {%- endfor %}
            </ol>
          </nav>
          {%- endif %}
          <div class="post-body">
{{ content | safe }}
          </div>
        </div>
      </article>

      {%- if older or newer %}
      <nav class="post-nav" aria-label="Post navigation">
        {%- if older %}
        <a class="post-nav-link post-nav-older" href="{{ older.url }}">
          <span class="post-nav-label">← Older</span>
          <span class="post-nav-title">{{ older.data.title }}</span>
        </a>
        {%- endif %}
        {%- if newer %}
        <a class="post-nav-link post-nav-newer" href="{{ newer.url }}">
          <span class="post-nav-label">Newer →</span>
          <span class="post-nav-title">{{ newer.data.title }}</span>
        </a>
        {%- endif %}
      </nav>
      {%- endif %}
    </main>
