{%- set pageTitle = title | default(site.name) -%}
{%- set pageDescription = description | default(site.description) -%}
{%- set shareTitle = ogTitle | default(pageTitle) -%}
{%- set shareDescription = ogDescription | default(pageDescription) -%}
{%- set canonicalUrl = (canonical | default(page.url)) | absolute -%}
{%- if isPost -%}
  {%- set shareImage = site.url + '/og/' + page.fileSlug + '.png' -%}
  {%- set shareImageAlt = title -%}
{%- else -%}
  {%- set shareImage = site.url + (ogImage | default('/images/og-2.png')) -%}
  {%- set shareImageAlt = ogImageAlt | default('Web3Evals — Coming soon') -%}
{%- endif -%}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#121110" />

    <title>{{ pageTitle }}</title>
    <meta name="description" content="{{ pageDescription }}" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="{{ canonicalUrl }}" />

    <meta property="og:type" content="{{ 'article' if isPost else 'website' }}" />
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:title" content="{{ shareTitle }}" />
    <meta property="og:description" content="{{ shareDescription }}" />
    <meta property="og:url" content="{{ canonicalUrl }}" />
    {%- if isPost %}
    <meta property="og:image" content="{{ site.url }}{% ogImage { fileSlug: page.fileSlug, title: title, description: description, date: page.date } %}" />
    {%- else %}
    <meta property="og:image" content="{{ shareImage }}" />
    {%- endif %}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="{{ shareImageAlt }}" />
    {%- if isPost %}
    <meta property="article:published_time" content="{{ page.date | dateIso }}" />
    {%- endif %}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ shareTitle }}" />
    <meta name="twitter:description" content="{{ shareDescription }}" />
    <meta name="twitter:image" content="{{ shareImage }}" />

    <link rel="icon" href="/images/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/atom+xml" title="{{ site.blog.title }}" href="/feed.xml" />
    <link
      rel="preload"
      href="/fonts/instrument-serif-latin-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {%- if isPost %}
    <link
      rel="preload"
      href="/fonts/inter-latin-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {%- endif %}
    <link rel="stylesheet" href="/css/tokens.css" />
    <link rel="stylesheet" href="/css/base.css" />
    <link rel="stylesheet" href="/css/site.css" />
    {%- if isBlog %}
    <link rel="stylesheet" href="/css/blog.css" />
    {%- endif %}
    <script src="/js/main.js" defer></script>
  </head>

  <body{% if isBlog %} class="page-blog"{% endif %}>
    <a class="skip-link visually-hidden" href="#main">Skip to content</a>
    <div class="grain" aria-hidden="true"></div>

{% include "partials/header.njk" %}

{{ content | safe }}
{% include "partials/footer.njk" %}
  </body>
</html>
